<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="20dp" android:background="?android:attr/colorBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <!--  Barre d'actions supérieure avec le Titre et la Poubelle  -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/result_title" android:textSize="24sp" android:textStyle="bold" android:textColor="?attr/colorPrimary"/>
            <ImageView android:id="@+id/btnDeleteCard" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@android:drawable/ic_menu_delete" app:tint="@android:color/holo_red_dark" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/action_delete"/>
        </LinearLayout>
        <!--  En-tête statut IA  -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="24dp" android:padding="12dp" android:background="#1A000000">
            <ProgressBar android:id="@+id/aiLoadingIndicator" android:layout_width="24dp" android:layout_height="24dp" android:indeterminateTint="?attr/colorPrimary"/>
            <TextView android:id="@+id/aiStatusText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/result_ai_loading" android:textSize="15sp" android:textStyle="bold"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/result_name" android:textSize="16sp" android:textStyle="bold"/>
        <EditText android:id="@+id/editName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:layout_marginBottom="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/result_surname" android:textSize="16sp" android:textStyle="bold"/>
        <EditText android:id="@+id/editSurname" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:layout_marginBottom="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/result_org" android:textSize="16sp" android:textStyle="bold"/>
        <EditText android:id="@+id/editOrg" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:layout_marginBottom="12dp" android:inputType="text"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/result_position" android:textSize="16sp" android:textStyle="bold"/>
        <EditText android:id="@+id/editPosition" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:layout_marginBottom="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/result_phone" android:textSize="16sp" android:textStyle="bold"/>
        <EditText android:id="@+id/editPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:inputType="phone" android:layout_marginBottom="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/result_email" android:textSize="16sp" android:textStyle="bold"/>
        <EditText android:id="@+id/editEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:inputType="textEmailAddress" android:layout_marginBottom="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/result_location" android:textSize="16sp" android:textStyle="bold"/>
        <EditText android:id="@+id/editLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:layout_marginBottom="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/result_linkedin" android:textSize="16sp" android:textStyle="bold"/>
        <EditText android:id="@+id/editLinkedin" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:layout_marginBottom="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/result_twitter" android:textSize="16sp" android:textStyle="bold"/>
        <EditText android:id="@+id/editTwitter" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:layout_marginBottom="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/result_facebook" android:textSize="16sp" android:textStyle="bold"/>
        <EditText android:id="@+id/editFacebook" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:layout_marginBottom="24dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/result_instagram" android:textSize="16sp" android:textStyle="bold"/>
        <EditText android:id="@+id/editInstagram" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:layout_marginBottom="24dp"/>
        <!--  Boutons  -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="32dp">
            <Button android:id="@+id/btnSave" android:layout_width="0dp" android:layout_weight="1" android:layout_height="54dp" android:text="@string/result_btn_save" android:textSize="15sp" android:textStyle="bold" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btnExport" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="54dp" android:text="@string/result_btn_export" android:textSize="15sp" android:textStyle="bold" android:layout_marginStart="8dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>